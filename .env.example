# HuggingFace token (accept access at https://huggingface.co/NCAIR1/N-ATLaS first)
HF_TOKEN=your_huggingface_token_here

# LLM Backend: 'ollama' (local), 'transformers' (GPU), or 'api' (remote server)
LLM_BACKEND=api

# Ollama (if using local backend)
OLLAMA_URL=http://localhost:11434

# Remote N-ATLAS API (if using Colab/Kaggle deployment)
# Run the notebook in notebooks/deploy_agrivoice_server.ipynb to get this URL
NATLAS_API_URL=https://your-ngrok-url.ngrok-free.app

# WhatsApp Business API (optional)
WHATSAPP_VERIFY_TOKEN=agrivoice_secret_token
WHATSAPP_API_TOKEN=your_whatsapp_token_here
